# Copia questo file in .env.local e compila con i valori del tuo progetto Supabase.
# Dashboard Supabase -> Project Settings -> API.
#
# ATTENZIONE: qui va SOLO la anon (public) key.
# La service_role key NON va mai nel client: vive nei Secrets della Edge Function.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...la-tua-anon-key...
